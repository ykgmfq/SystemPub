#!/usr/bin/make -f

export CGO_ENABLED = 0
export GOFLAGS = -mod=vendor
export GOPROXY = off
export GOTOOLCHAIN = local
# The Launchpad builders have no writable home directory,
# so the Go build cache must live inside the build tree.
export GOCACHE = $(CURDIR)/.gocache

%:
	dh $@

override_dh_auto_build:
	go build -ldflags "-s -w" -o systempub .

override_dh_auto_test:
	go test ./...

# The fire drill fakes problems, so its timer must stay off until the user enables it.
# The oneshot service is left out, because starting it on install would run a drill.
override_dh_installsystemd:
	dh_installsystemd systempub.service
	dh_installsystemd --no-enable --no-start systempub-firedrill.timer

# The binary is built static and already stripped by the linker flags.
override_dh_strip override_dh_dwz:
